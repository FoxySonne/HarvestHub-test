# Public browser configuration. These values are not service-role secrets.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-anon-key

# Edge Function secrets. Never expose these values in browser files.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ALLOWED_ORIGINS=https://your-production-domain.example,https://your-test-domain.example
